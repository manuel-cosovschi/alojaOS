# AlojaOS — variables de entorno
#
# Copiá este archivo a .env.local y completá lo que necesites. `.env*.local`
# está en .gitignore: ningún secreto va al repositorio.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# La URL y la clave pública del proyecto. La clave pública viaja en el
# navegador de cualquiera que entre a la página de un complejo: está protegida
# por RLS, y `npm run aislamiento` comprueba que lo esté de verdad.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave de servicio saltea RLS. La necesita sólo el alta de un complejo
# nuevo, del lado del servidor. NUNCA la pongas en una variable NEXT_PUBLIC_ ni
# la cargues donde no haga falta.
SUPABASE_SERVICE_ROLE_KEY=

# El token personal y el identificador del proyecto. Los usan tres comandos, y
# ninguno hace falta para que el sitio funcione:
#
#   npm run db:migrate   aplica las migraciones que falten
#   npm run verificar    corre verificar-produccion.sql y falla si falta algo
#   npm run huellas      imprime el md5 del cuerpo de cada función
#
# Van por la Management API, que no pasa por el conector MCP —ese corta las
# llamadas con UPDATE, DELETE o DROP sin ejecutarlas, ver supabase/a_mano/—.
#
# OJO: el token es de la CUENTA, no del proyecto. Quien lo tenga puede crear y
# borrar cualquier proyecto. Conviene generarlo, usarlo y revocarlo.
#
# Sin token, los mismos archivos .sql se pegan en el SQL Editor del dashboard.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# El sitio
# ---------------------------------------------------------------------------
# El dominio raíz. De acá sale la dirección de la página de cada complejo
# (tucomplejo.alojaos.shop).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sólo si las páginas de los complejos cuelgan de un dominio distinto del sitio.
NEXT_PUBLIC_ROOT_DOMAIN=

# ---------------------------------------------------------------------------
# Por dónde te escribe un cliente
# ---------------------------------------------------------------------------
# Van en la página comercial. Son `NEXT_PUBLIC_` a propósito: se muestran.
#
# Sin cargarlas, el botón principal de la página de venta apunta a un número
# inventado —«00000000000»— que se ve a la legua y que `npm run prueba:comercial`
# marca como falla. Es a propósito: antes el valor por defecto parecía un
# teléfono de verdad, y la página salió a producción con el único llamado a la
# acción apuntando a un número que no era de nadie. No falló nada: el enlace
# existía, el botón andaba, y el que lo apretaba no llegaba a ninguna parte.
NEXT_PUBLIC_WHATSAPP_CONTACTO=
NEXT_PUBLIC_MAIL_CONTACTO=

# ---------------------------------------------------------------------------
# Para probar sin Supabase
# ---------------------------------------------------------------------------
# `./scripts/dev-local.sh` levanta Postgres y PostgREST acá nomás y sobreescribe
# .env.local apuntando ahí. No hace falta cargar nada a mano para eso.

# ---------------------------------------------------------------------------
# Los mails al huésped
# ---------------------------------------------------------------------------
# Sin estas dos, el sistema NO manda mails y lo deja anotado: cada reserva queda
# con un aviso en estado SIN_CONFIGURAR, y el panel le muestra al dueño a qué
# huésped tiene que escribirle él. Es el estado honesto de un sistema al que
# todavía no le cargaron el proveedor —no se pierde nada en silencio— pero es un
# estado provisorio.
#
# La clave de Resend. Mandar es sólo transaccional: «te guardamos la unidad»,
# «tu reserva está confirmada», «no pudimos confirmarla». Nada de mails fríos
# desde el dominio del producto.
RESEND_API_KEY=

# El remitente, con un dominio verificado en Resend. Sin esto no se manda nada,
# a propósito: un mail desde el dominio de prueba del proveedor cae en spam y le
# muestra al huésped una dirección que no es la del complejo. Peor que no
# mandarlo.
#
#   RESEND_DE="Cabañas del Sol <reservas@alojaos.shop>"
RESEND_DE=
